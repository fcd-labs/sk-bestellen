# Single source of truth for all versions (semantic versioning). Raise by hand or with `fcd bump`.
# A higher container version means a higher version of the sub-product (checked by the code gate).
PRODUCT=showkitchen
SUBPRODUCT=bestellen
SUBPRODUCT_VERSION=0.1.0
# Containers of the sub-product Bestellen
BESTELLEN_FRONTEND_VERSION=0.1.0
BESTELLEN_BACKEND_VERSION=0.1.0
# Stubs: own lifecycle, deployed along, not part of Bestellen and not released
STUB_KITCHEN_VERSION=0.1.0
STUB_BAR_VERSION=0.1.0
STUB_CASH_REGISTER_VERSION=0.1.0
